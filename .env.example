# --- Prototype ---------------------------------------------------------------
# When true, identity comes from the demo provider (cookie-selected mock user).
DEMO_MODE=true

# --- Future: Microsoft Entra ID (not implemented in this PoC) ----------------
# See src/lib/auth/entra-provider.ts and README "Microsoft production path".
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=
# Optional: map Entra / Microsoft Graph group object IDs to application roles.
AZURE_AD_GROUP_OPS_ANALYST=
AZURE_AD_GROUP_COMPLIANCE_APPROVER=
AZURE_AD_GROUP_ADMIN=

# --- Demo hosting -------------------------------------------------------------
# When the app is reached through a forwarding proxy that rewrites `Origin`
# (so it no longer matches `x-forwarded-host`), list the Origin host value(s)
# Server Actions (role switch, workflow actions) should accept.
# SERVER_ACTIONS_ALLOWED_ORIGINS=localhost,localhost:3000
