{
  "name": "fintech_mock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:reset": "prisma db push --skip-generate --force-reset && tsx prisma/seed.ts --force",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "15.5.26",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
